{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the main window. It opens the addresses listed below and no other.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://mempool.space/*" },
        { "url": "https://github.com/gerfaut-wallet/gerfaut-desktop/releases/latest" },
        { "url": "https://gerfaut-wallet.com/premium" },
        { "url": "https://gerfaut-wallet.com/premium#renew" },
        { "url": "https://t.me/GerfautAlertsBot?start=*" },
        { "url": "https://t.me/GerfautAlertsBot" },
        { "url": "ntfy://ntfy.gerfaut-wallet.com/*" }
      ]
    },
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
