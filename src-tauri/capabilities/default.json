{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the main window. It listens to what the Rust side announces, and opens the addresses listed below and no other. Everything else it asks for goes through the app's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://mempool.space/*" },
        { "url": "https://github.com/gerfaut-wallet/gerfaut-desktop/releases/latest" },
        { "url": "https://gerfaut-wallet.com/premium" },
        { "url": "https://gerfaut-wallet.com/premium#renew" },
        { "url": "https://t.me/GerfautAlertsBot?start=*" },
        { "url": "https://t.me/GerfautAlertsBot" },
        { "url": "ntfy://ntfy.gerfaut-wallet.com/*" }
      ]
    }
  ]
}
